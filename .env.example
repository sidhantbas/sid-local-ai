# Copy to .env (git-ignored) and fill in. Read by the scripts and by docker compose
# (--env-file .env). Values here are placeholders, never real secrets.

# Unsloth Studio: port, and the API key it prints for the label "open-webui"
# (scripts/stack/start-unsloth.sh creates it on the first start)
UNSLOTH_PORT=8890
UNSLOTH_API_KEY=sk-unsloth-...

# Hermes dashboard login (http://localhost:9119)
HERMES_DASHBOARD_USER=sid
HERMES_DASHBOARD_PASSWORD=choose-a-long-password

# Optional: Strata's port (default 8080)
# STRATA_PORT=8080
